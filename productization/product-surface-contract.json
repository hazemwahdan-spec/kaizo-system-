{
  "$schema": "kaizo-product-surface-contract-v1",
  "phase": 7,
  "purpose": "commercial product surface over the frozen Core Engine",
  "execution_authorized_default": false,
  "coach_final_authority": true,
  "evidence_before_claim": true,
  "roles": {
    "academy": {
      "surfaces": [
        "dashboard",
        "groups",
        "coaches",
        "athletes",
        "approved_reports"
      ],
      "allowed_actions": [
        "manage_groups",
        "assign_coaches",
        "view_authorized_reports"
      ],
      "mutation_requires": [
        "authenticated_identity",
        "tenant_membership",
        "server_side_rbac"
      ],
      "forbidden": [
        "execute_training",
        "override_coach_decision",
        "bypass_evidence_gate",
        "export_unapproved_data"
      ]
    },
    "coach": {
      "surfaces": [
        "decision_cases",
        "adaptation",
        "decision_loop",
        "digital_twin",
        "audit",
        "athlete_roster",
        "athlete_lifecycle",
        "training_groups",
        "athlete_decision_cycle_history",
        "coach_home_dashboard",
        "coach_current_priority_queue",
        "coach_decision_cycle_workspace",
        "coach_action_history"
      ],
      "allowed_actions": [
        "request_core_decision",
        "record_intervention",
        "record_retest",
        "review_state",
        "export_approved",
        "manage_owned_athletes",
        "change_owned_athlete_lifecycle",
        "manage_owned_training_groups",
        "view_owned_athlete_decision_history",
        "view_owned_coach_dashboard_summary",
        "view_evidence_backed_current_priority_queue",
        "view_owned_athlete_decision_workspace",
        "view_owned_coach_action_history"
      ],
      "mutation_requires": [
        "authenticated_identity",
        "tenant_membership",
        "assigned_resource_scope",
        "coach_final_authority",
        "verified_coach_ownership",
        "reasoned_status_transition",
        "tenant_scoped_audit",
        "verified_coach_ownership_for_decision_history_reads",
        "verified_coach_tenant_scope_for_dashboard_reads",
        "verified_coach_tenant_scope_for_priority_queue_reads",
        "verified_coach_tenant_scope_for_decision_workspace_reads",
        "verified_coach_tenant_and_actor_scope_for_action_history_reads"
      ],
      "forbidden": [
        "autonomous_execution",
        "safety_override",
        "evidence_bypass",
        "cross_tenant_access"
      ]
    },
    "athlete": {
      "surfaces": [
        "my_progress",
        "approved_feedback",
        "competition_results"
      ],
      "allowed_actions": [
        "view_own_progress",
        "view_approved_feedback",
        "view_own_results"
      ],
      "writes": false,
      "forbidden": [
        "request_core_decision",
        "record_intervention",
        "export_records",
        "change_coach_decision"
      ]
    },
    "parent": {
      "surfaces": [
        "linked_athlete",
        "progress",
        "approved_reports"
      ],
      "allowed_actions": [
        "view_linked_progress",
        "view_approved_reports"
      ],
      "writes": false,
      "forbidden": [
        "request_core_decision",
        "record_intervention",
        "export_records",
        "change_coach_decision"
      ]
    }
  },
  "global_denials": [
    "execution_authorized=true",
    "implicit_execution",
    "safety_override",
    "evidence_bypass",
    "coach_authority_bypass",
    "cross_tenant_access"
  ],
  "production_verified": false,
  "athlete_lifecycle": {
    "statuses": [
      "ACTIVE",
      "INACTIVE",
      "SUSPENDED",
      "ARCHIVED"
    ],
    "transitions": {
      "ACTIVE": [
        "INACTIVE",
        "SUSPENDED",
        "ARCHIVED"
      ],
      "INACTIVE": [
        "ACTIVE",
        "ARCHIVED"
      ],
      "SUSPENDED": [
        "ACTIVE",
        "INACTIVE",
        "ARCHIVED"
      ],
      "ARCHIVED": []
    },
    "requirements": [
      "verified_coach_ownership",
      "non_empty_reason",
      "atomic_status_and_audit_write"
    ],
    "terminal_status": "ARCHIVED"
  },
  "athlete_decision_cycle_history": {
    "access": "read_only",
    "scope": "verified_coach_and_tenant_owned_athlete",
    "source_records": [
      "kaizo_decision_records",
      "kaizo_training_workflow_records",
      "kaizo_training_plans"
    ],
    "historical_backfill": false,
    "client_supplied_linkage": false,
    "coach_final_authority": true,
    "execution_authorized": false
  },
  "coach_home_dashboard": {
    "access": "read_only",
    "scope": "verified_coach_and_tenant_owned_records",
    "aggregates": [
      "owned_athlete_counts_by_status",
      "owned_training_group_and_membership_counts",
      "owned_decision_cycle_count",
      "five_most_recent_owned_decisions"
    ],
    "priority_queue": {
      "available": false,
      "owned_by": "FEAT-007"
    },
    "no_synthetic_metrics": true,
    "coach_final_authority": true,
    "execution_authorized": false
  },
  "coach_decision_cycle_workspace": {
    "mode": "read_only",
    "source": "persisted_assessment_evidence_decision_training_records",
    "scope": "verified_coach_owned_athlete_in_verified_tenant",
    "insufficient_evidence_policy": "fail_closed_when_durable_postgresql_sources_are_unavailable",
    "historical_backfill": false,
    "writes": false,
    "audit_events_on_read": false
  },
  "coach_action_history": {
    "access": "read_only",
    "scope": "verified_coach_actor_and_tenant_owned_athlete",
    "sources": [
      "tenant_scoped_audit_logs",
      "owned_decision_records",
      "FEAT-044_decision_state_links"
    ],
    "legacy_unscoped_audit": "excluded",
    "feat_044_actor_attribution": "unverified_and_not_attributed",
    "writes": false,
    "audit_events_on_read": false,
    "coach_final_authority": true,
    "execution_authorized": false
  }
}

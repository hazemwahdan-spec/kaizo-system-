{
  "schema": "kaizo-identity-rbac-boundary-v1",
  "execution_authorized_default": false,
  "authority_model": "Coach Final Authority",
  "enforcement": "server-side",
  "identity_required": true,
  "roles": {
    "academy": {
      "scope": "tenant",
      "permissions": [
        "manage_groups",
        "assign_coaches",
        "view_authorized_reports"
      ]
    },
    "coach": {
      "scope": "tenant-assigned-athletes",
      "permissions": [
        "create_decision_case",
        "record_intervention",
        "record_retest",
        "review_state",
        "view_audit"
      ]
    },
    "athlete": {
      "scope": "self",
      "permissions": [
        "view_own_progress",
        "view_approved_feedback",
        "view_own_competition_results"
      ]
    },
    "parent": {
      "scope": "explicitly-linked-athletes",
      "permissions": [
        "view_linked_progress",
        "view_approved_reports"
      ]
    }
  },
  "denials": [
    "execute_without_coach_approval",
    "override_safety_hold",
    "bypass_evidence_gate",
    "change_coach_decision",
    "cross_tenant_access",
    "export_unapproved_data"
  ],
  "required_controls": [
    "authentication",
    "server_side_rbac",
    "tenant_scope_check",
    "resource_ownership_check",
    "audit_event_on_privileged_action"
  ],
  "not_yet_production_verified": true,
  "oidc_permissions": {
    "source": "verified_auth0_access_token_permissions_array",
    "exact_match_only": true,
    "required_api_settings": [
      "RBAC enabled",
      "Add Permissions in Access Token enabled"
    ],
    "academy": {
      "academy:tenant:bind": "bind academy to signed tenant",
      "academy:membership:manage": "manage coach memberships subject to database delegation hierarchy",
      "academy:athlete:enroll": "enrol athlete subject to ownership and tenant constraints",
      "academy:coach:assign": "assign coach subject to active membership and enrolment"
    },
    "coach": {
      "academy:read": "read active academy choices and minimal assigned roster"
    },
    "missing_or_malformed_claim": "deny",
    "role_string_alone_grants_permission": false
  }
}
